# ============================================
# GigMate 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# ---- 数据库 ----
# Neon 托管 PostgreSQL 连接串
# 免费申请: https://neon.tech
# 格式: postgresql://user:password@host/db?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- Auth.js ----
# 生成方式: npx auth secret 或 openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# ---- OAuth 登录（可选）----
# GitHub OAuth: https://github.com/settings/developers
# 回调地址: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# Google OAuth: https://console.cloud.google.com/apis/credentials
# 回调地址: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
