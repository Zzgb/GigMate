/**
 * schema.prisma
 * Prisma 数据库 Schema - User/Task/Application/Review/Conversation/Message 模型定义
 * 新增: Milestone/MilestoneApproval/MilestoneAttachment/Transaction (里程碑与薪酬系统)
 * 修改日期: 2026-05-25
 * 修改人: Claude Code + DeepSeek V4 Pro
 */

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  avatarUrl    String?
  roles        String[] @default(["FREELANCER"])
  balance      Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks             Task[]        @relation("Employer")
  applications      Application[]
  reviewsReceived   Review[]      @relation("Reviewee")
  reviewsGiven      Review[]      @relation("Reviewer")
  conversationsAs1  Conversation[] @relation("User1")
  conversationsAs2  Conversation[] @relation("User2")
  messages          Message[]

  submittedApprovals MilestoneApproval[] @relation("Submitter")
  reviewedApprovals  MilestoneApproval[] @relation("Reviewer")
  paidTransactions   Transaction[]       @relation("Payer")
  receivedTransactions Transaction[]     @relation("Payee")
  operatedTransactions Transaction[]     @relation("Operator")
  statusLogs         TaskStatusLog[]     @relation("StatusOperator")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String
  budget      Float
  budgetMin   Float?
  deadline    DateTime?
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  category    String?
  skills      String[]
  escrow      Float     @default(0)
  parentTaskId String?
  parentTask   Task?     @relation("TaskChain", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks   Task[]    @relation("TaskChain")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employerId  String
  employer    User          @relation("Employer", fields: [employerId], references: [id])
  applications Application[]
  reviews     Review[]
  conversations Conversation[]

  milestones   Milestone[]
  transactions Transaction[]
  statusLogs   TaskStatusLog[]
}

model Application {
  id        String   @id @default(cuid())
  message   String
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId        String
  task          Task   @relation(fields: [taskId], references: [id])
  freelancerId  String
  freelancer    User   @relation(fields: [freelancerId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  taskId     String
  task       Task   @relation(fields: [taskId], references: [id])
  reviewerId String
  reviewer   User   @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User   @relation("Reviewee", fields: [revieweeId], references: [id])
}

model Conversation {
  id        String    @id @default(cuid())
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user1Id     String
  user1       User      @relation("User1", fields: [user1Id], references: [id])
  user2Id     String
  user2       User      @relation("User2", fields: [user2Id], references: [id])
  user1ReadAt DateTime?
  user2ReadAt DateTime?
  messages    Message[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

// ---- 里程碑系统 ----

model Milestone {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  order     Int
  name      String   // 节点名称
  criteria  String   // 验收条件
  ratio     Float    // 付款比例 0-100
  amount    Float    // ratio/100 * task.budget
  status    String   @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED
  version   Int      @default(0) // 乐观锁
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals    MilestoneApproval[]
  transactions Transaction[]

  @@unique([taskId, order])
}

model MilestoneApproval {
  id              String   @id @default(cuid())
  milestoneId     String
  milestone       Milestone @relation(fields: [milestoneId], references: [id])
  submittedById   String
  submittedBy     User      @relation("Submitter", fields: [submittedById], references: [id])
  description     String?   // 验收材料文字描述
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById    String?
  reviewedBy      User?     @relation("Reviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attachments MilestoneAttachment[]
}

model MilestoneAttachment {
  id           String   @id @default(cuid())
  approvalId   String
  approval     MilestoneApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  filename     String   // UUID 重命名后的磁盘文件名
  originalName String   // 用户上传的原始文件名
  fileSize     Int      // 字节
  mimeType     String
  url          String   // /uploads/milestone-attachments/{uuid}.ext
  createdAt    DateTime @default(now())
}

// ---- 交易日志 ----

model Transaction {
  id           String    @id @default(cuid())
  taskId       String?
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  milestoneId  String?
  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  type         String    // DEPOSIT | PLATFORM_FEE | FREELANCER_PAYMENT | REFUND | TRANSFER_OUT | TRANSFER_IN
  amount       Float
  payerId      String?
  payer        User?     @relation("Payer", fields: [payerId], references: [id], onDelete: SetNull)
  payeeId      String?
  payee        User?     @relation("Payee", fields: [payeeId], references: [id], onDelete: SetNull)
  escrowBefore Float?
  escrowAfter  Float?
  operatorId   String?
  operator     User?     @relation("Operator", fields: [operatorId], references: [id], onDelete: SetNull)
  description  String?
  createdAt    DateTime  @default(now())

  @@index([taskId])
  @@index([createdAt])
}

// ---- 任务状态日志 ----

model TaskStatusLog {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus String?  // 旧状态，创建时为 null
  toStatus   String   // 新状态
  event      String   // 事件描述
  operatorId String?
  operator   User?    @relation("StatusOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([taskId, createdAt])
}
